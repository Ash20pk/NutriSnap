{
  "expo": {
    "name": "Loggr",
    "slug": "nutrisnap",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "loggr",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.ash20pk.loggr",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Loggr needs access to your camera to take photos of your meals for AI-powered food recognition and portion tracking.",
        "NSPhotoLibraryUsageDescription": "Loggr needs access to your photo library to select meal photos.",
        "NSMicrophoneUsageDescription": "Loggr needs access to your microphone for voice meal logging.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/foreground.png",
        "backgroundColor": "#2F593E"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ],
      "usesCleartextTraffic": true,
      "package": "com.ash20pk.loggr",
      "pageAlignment": "16kb"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      ["expo-web-browser", { "experimentalLauncherActivity": false }],
      "expo-adi-registration",
      [
        "expo-build-properties",
        {
          "android": {
            "useLegacyPackaging": true
          }
        }
      ],
      "react-native-vision-camera",
      [
        "react-native-fast-tflite",
        {
          "enableCoreMLDelegate": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#2F593E"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Loggr to access your camera for meal photo logging."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Loggr to access your photos."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c81eaf45-57e0-49c1-b331-7817d85e9d11"
      }
    }
  }
}
